# Dare to Care — environment variables.
#
# Copy to `.env` for local development. In production these are set in the
# Netlify dashboard (Site configuration → Environment variables), not here.
#
# Never commit a real .env. The service-role key below is equivalent to a
# password on the entire database.

# ── Frontend (Vite) ────────────────────────────────────────────────────────
# Both are baked into the built JavaScript and are visible to anyone who opens
# the site. That is fine and intended: the anon key only identifies the project.
# Everything it is allowed to read or write is decided by Row Level Security in
# Postgres, not by holding the key.
#
# Supabase dashboard → Project settings → API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ── Netlify functions (server-side only) ───────────────────────────────────
# THE SERVICE-ROLE KEY BYPASSES ROW LEVEL SECURITY ENTIRELY. It must never be
# given a VITE_ prefix, imported into anything under dare-to-care-forms/, or
# pasted anywhere a browser could reach. It belongs only in Netlify's function
# environment.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── One-time migration only (npm run migrate) ──────────────────────────────
# Needed to apply schema.sql and storage.sql over a direct connection, and to
# pull the data out of Firebase. Not used by the running app, and not needed in
# Netlify — delete both once the migration is done.
#
# Project settings → Database → Connection string → URI, with your database
# password substituted for [YOUR-PASSWORD].
SUPABASE_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-ref.supabase.co:5432/postgres
# The existing Firebase key:  netlify env:get FIREBASE_SERVICE_ACCOUNT
FIREBASE_SERVICE_ACCOUNT=

# ── Outlook ingestion (unchanged by the Supabase migration) ────────────────
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
DTC_MAILBOX=intake@daretocarehomecare.com

# Shared key guarding /.netlify/functions/preflight-ingestion. Unset, that
# endpoint refuses to run rather than defaulting to open.
PREFLIGHT_KEY=
