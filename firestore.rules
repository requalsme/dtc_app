rules_version = '2';

// Dare to Care - Firestore security rules.
// Reads require login; sensitive writes are restricted by role; audit is
// append-only; certificates are created by the course site (anonymous auth).

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function hasUserDoc() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isAdmin() {
      return isSignedIn() && hasUserDoc() && userRole() == 'admin';
    }
    function isStaff() {
      return isSignedIn() && hasUserDoc() && (userRole() == 'admin' || userRole() == 'officeManager');
    }
    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    match /metadata/setup {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSelf(userId) || isAdmin();
      allow delete: if false;
    }

    match /clients/{clientId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    // Form templates define what every form asks and what gets signed. Changing
    // one silently changes the meaning of every future submission, so this is
    // admin-only — an office manager can assign and review forms but cannot
    // alter the forms themselves.
    match /templates/{templateId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /submissions/{submissionId} {
      allow read: if isSignedIn();

      // Anyone signed in may file a form; it must arrive as "submitted" and
      // stamped with its author, so a record can't be back-dated or attributed
      // to someone else at creation.
      allow create: if isSignedIn()
                    && request.resource.data.status == 'submitted';

      // A submitted form is a signed record. Office managers and admins may
      // review it, request a correction, or attach the filed PDF. The caregiver
      // who filed it may only touch it while it is sitting in needsCorrection —
      // i.e. to fix and resubmit what they were asked to fix.
      allow update: if isStaff()
                    || (
                         resource.data.caregiverId == request.auth.uid
                         && resource.data.status == 'needsCorrection'
                       );

      // Signed records are never destroyed. Corrections supersede; they don't erase.
      allow delete: if false;
    }

    match /tasks/{taskId} {
      allow read: if isSignedIn();
      allow create, delete: if isStaff();
      allow update: if isSignedIn();
    }

    match /audit/{eventId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    match /certificates/{certId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.source == 'course-site';
      allow update: if isStaff();
      allow delete: if false;
    }

    // One-time identity handoff tokens (app -> course site). A signed-in app user
    // creates a token for themselves; the course site reads it to sign the user in
    // without a second login. Not updatable or deletable.
    match /courseHandoffs/{token} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Persistent course progress per user (written by the course site, keyed by
    // the user's app uid). Any signed-in session may read/write; the key is an
    // unguessable uid. Not deletable.
    match /courseProgress/{key} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
