rules_version = '2';

// Dare to Care - Firestore security rules.
// Reads require login; sensitive writes are restricted by role; audit is
// append-only; certificates are created by the course site (anonymous auth).

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function hasUserDoc() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isAdmin() {
      return isSignedIn() && hasUserDoc() && userRole() == 'admin';
    }
    function isStaff() {
      return isSignedIn() && hasUserDoc() && (userRole() == 'admin' || userRole() == 'officeManager');
    }
    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    // Independent of role. Raina's real job in the roster can be "caregiver" —
    // that's genuinely the work assigned to her — while this is a second,
    // separate grant for the dev portal. Only ever set by hand in Firestore
    // (see the users rule below, which blocks self-granting it), never by the
    // app, so it can't become something anyone hands themselves.
    function isDevUser() {
      return isSignedIn() && hasUserDoc() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.devAccess == true;
    }

    match /metadata/setup {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Ingestion state — the Outlook watermark and last-poll result. Written
    // only by the scheduled function through the admin SDK, which bypasses
    // these rules; no browser has any business moving the watermark, because
    // moving it forwards silently skips unread referrals.
    match /metadata/ingestion {
      allow read: if isStaff();
      allow write: if false;
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      // devAccess is deliberately excluded from what isSelf can write. Without
      // this, someone editing their own profile (name, phone, password-change
      // flag — all legitimately self-serve) could add one field and grant
      // themselves the dev portal. Only an existing dev/admin can hand it out.
      // (`resource == null` on create — diff against resource.data would error
      // on a document that doesn't exist yet, so create just bars the field
      // outright for a self-write rather than diffing against nothing.)
      allow create: if isAdmin() || isDevUser() || (
        isSelf(userId) && !request.resource.data.keys().hasAny(['devAccess'])
      );
      allow update: if isAdmin() || isDevUser() || (
        isSelf(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['devAccess'])
      );
      allow delete: if false;
    }

    match /clients/{clientId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    // Form templates define what every form asks and what gets signed. Changing
    // one silently changes the meaning of every future submission, so this is
    // admin-only — an office manager can assign and review forms but cannot
    // alter the forms themselves.
    match /templates/{templateId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isDevUser();
    }

    match /submissions/{submissionId} {
      allow read: if isStaff() || (isSignedIn() && resource.data.caregiverId == request.auth.uid);

      // Anyone signed in may file a form; it must arrive as "submitted" and
      // stamped with its author, so a record can't be back-dated or attributed
      // to someone else at creation.
      allow create: if isSignedIn()
                    && request.resource.data.status == 'submitted';

      // A submitted form is a signed record. Office managers and admins may
      // review it, request a correction, or attach the filed PDF. The caregiver
      // who filed it may only touch it while it is sitting in needsCorrection —
      // i.e. to fix and resubmit what they were asked to fix.
      // Soft-delete rides this same update path, but is carved out to dev
      // users only — an office manager can review and correct a record, but
      // removing one from view (even reversibly) is an owner-level call.
      allow update: if (
                         isStaff()
                         || (
                              resource.data.caregiverId == request.auth.uid
                              && resource.data.status == 'needsCorrection'
                            )
                       ) && (
                         !request.resource.data.diff(resource.data).affectedKeys()
                           .hasAny(['deletedAt', 'deletedBy', 'deletedById', 'deleteReason'])
                         || isDevUser()
                       );

      // Signed records are not destroyed by anyone in the ordinary course of
      // work — corrections supersede, they don't erase, and that holds for
      // every role up through office manager.
      //
      // The dev portal is the one exception, granted explicitly (hard delete,
      // asked for after soft delete). Even here it isn't a bare permission:
      // `hardDeleteSubmission` in store.js is the only place that calls this,
      // and it refuses to run unless the record is already soft-deleted —
      // enforced there, but the rule below is what actually stops a request
      // that skips that check, since client code is not the security boundary.
      allow delete: if isDevUser() && resource.data.deletedAt != null;
    }

    // Documents that arrived from outside the app — emailed authorizations,
    // certification results, imported GoFormz records — waiting for a human to
    // say who they belong to.
    //
    // Read is office-manager-and-above, not any signed-in user: an unreviewed
    // queue is a pile of other people's clinical documents with no filing
    // decision made yet, and a caregiver has no reason to browse it.
    //
    // Writes are closed entirely. Entries are created by the ingestion function
    // and resolved by the resolveInboundDocument / dismissInboundDocument
    // callables, both of which run with admin privileges and re-check the
    // caller's role. Keeping the browser out means a reviewer cannot mark a
    // document filed without the server also copying it into the person's file
    // and writing the audit entry — the record and the reality stay together.
    match /inbound/{inboundId} {
      allow read: if isStaff();
      allow write: if false;
    }

    // Employment applications, submitted from careers.daretocarehomecare.com
    // (a separate site, dtc-jobapp) but written into this same Firebase
    // project's Firestore. Contains an encrypted SSN and other applicant PII,
    // so read is office-manager-and-above only — same bar as `inbound`.
    //
    // Created server-side only, by dtc-jobapp's submit-application function
    // running under the Admin SDK, which bypasses these rules entirely — a
    // browser can never create one, which is what stops someone from forging
    // an application record directly in Firestore.
    //
    // Update is narrowed to exactly the review fields. A reviewer can mark an
    // application reviewed and leave a note; they cannot rewrite what the
    // applicant actually submitted.
    match /applications/{applicationId} {
      allow read: if isStaff();
      allow create: if false;
      allow update: if isStaff()
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['status', 'reviewedAt', 'reviewedBy', 'reviewNote']);
      allow delete: if false;
    }

    match /tasks/{taskId} {
      allow read: if isSignedIn();
      allow create, delete: if isStaff();
      allow update: if isSignedIn();
    }

    match /audit/{eventId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // Scanned documents attached to a person — licences, I-9s, background
    // check results, packets signed on paper.
    //
    // Create is staff-only and stamped: a caregiver must not be able to drop a
    // document into their own file claiming it's a clean CBI result. Vetting
    // evidence is only worth anything if the person it vets didn't supply it.
    //
    // No update and no delete, by anyone. These are evidence. A wrong upload is
    // superseded by a correct one, never edited away — same rule as submissions.
    match /documents/{docId} {
      allow read: if isStaff() || (isSignedIn() && resource.data.subjectId == request.auth.uid);
      allow create: if isStaff()
                    && request.resource.data.uploadedById == request.auth.uid
                    && request.resource.data.subjectType in ['client', 'staff'];
      allow update, delete: if false;
    }

    match /certificates/{certId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.source == 'course-site';
      allow update: if isStaff();
      allow delete: if false;
    }

    // One-time identity handoff tokens (app -> course site). A signed-in app user
    // creates a token for themselves; the course site reads it to sign the user in
    // without a second login. Not updatable or deletable.
    // One-time identity handoff, app -> course site. The course site reads these
    // anonymously, which is why the token is unguessable and short-lived.
    match /courseHandoffs/{token} {
      allow read: if isSignedIn();

      // A handoff may only be minted for yourself, and a new hire may only mint
      // one once training has been released for them. Enforced here as well as
      // in the client so the gate can't be bypassed by calling Firestore
      // directly — the client check is convenience, this is the boundary.
      allow create: if isSignedIn()
                    && request.resource.data.uid == request.auth.uid
                    && (
                         userRole() != 'newHire'
                         || get(/databases/$(database)/documents/users/$(request.auth.uid))
                              .data.coursesUnlockedAt != null
                       );

      allow update, delete: if false;
    }

    // Persistent course progress per user (written by the course site, keyed by
    // the user's app uid). Any signed-in session may read/write; the key is an
    // unguessable uid. Not deletable.
    match /courseProgress/{key} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
